# ============================================
# ionflow-qa-catalyst — Variables de Entorno
# ============================================
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas el archivo .env al repositorio.

# --- Conexión SSH al servidor de BD ---
DB_SSH_HOST=
DB_SSH_USER=
DB_SSH_KEY_PATH=~/.ssh/ionflow_key
DB_SSH_PORT=22

# --- Túnel local (puerto donde se expone la BD) ---
DB_LOCAL_PORT=5433

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
