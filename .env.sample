# =============================================================================
# ionflow-qa-catalyst — Variables de Entorno
# =============================================================================
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env ni los perfiles .env.<ambiente> al repositorio (.gitignore).

# --- Playwright MCP — testing asistido (ambiente asignado al QA) ---
IONFLOW_ENVIRONMENT_URL=
IONFLOW_KC_DOMAIN=
IONFLOW_COMPANY_USERNAME=
IONFLOW_COMPANY_PASSWORD=
IONFLOW_ADMIN_USERNAME=
IONFLOW_ADMIN_PASSWORD=

# --- Repositorio de automatización (solo lectura desde el catalyst) ---
# Ruta local de bot-test; por defecto ../bot-test
BOT_TEST_PATH=

# --- Perfiles por ambiente para las suites del release ---
# Se guardan FUERA del repo como .env.preprod y .env.prod-testco, con las mismas
# claves IONFLOW_* de arriba:
#   .env.preprod      -> preprod (smoke gate, sanity, regression capa 1 y 2)
#   .env.prod-testco  -> producción con la company de prueba (smoke post-despliegue)

# --- Conexión SSH a la BD (opcional — validaciones de datos) ---
DB_SSH_HOST=
DB_SSH_USER=
DB_SSH_KEY_PATH=
DB_SSH_PORT=

# --- Túnel local (puerto donde se expone la BD) ---
DB_LOCAL_PORT=

# --- PostgreSQL ---
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
